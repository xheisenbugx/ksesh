#!/usr/bin/env bash
# fzf picker over the coding agents running in kitty: the ones that need you
# first, live (it refreshes every 2 seconds), with the agent's screen or its
# git diff on the right. Most things you'd switch to an agent for can be done
# from here without leaving the window you're in. The footer only shows the
# keys that do something for the selected agent:
#
#   enter   go to the agent
#   ctrl-y  approve: press enter in a waiting agent (its permission prompt)
#   ctrl-x  interrupt a working agent, or deny a waiting one (escape)
#   ctrl-o  reply: type a message and send it to the agent
#   ctrl-s  mark seen: back to idle, off the attention list
#   ctrl-g  preview what the agent did instead of its screen, and back: its
#           branch against the base, commits, files (● not committed yet) and
#           diff, with generated-size files folded
#   alt-b   open the pull request of the agent's branch in the browser
#
# and, not in the footer:
#
#   alt-d   the review full screen, everything unfolded, in less
#   ctrl-d  scroll the preview down half a page (ctrl-u up)
#   alt-w   close the agent's window (asks first)
#   ctrl-/  hide or show the preview
#
# Install: copy this file to ~/.config/kitty/, make it executable, and add to
# kitty.conf:
#
#   map super+a launch --type=overlay --cwd=current ~/.config/kitty/ksesh-agents-fzf
#
# Needs listen_on in kitty.conf, like ksesh-fzf, and fzf 0.59+.
set -euo pipefail

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Subcommands the key bindings run. The window id is the first argument.
case "${1:-}" in
list)
  # Lines are: window id, status, the row shown.
  exec ksesh agent list --ids
  ;;
footer)
  # The keys that do something for an agent in this status.
  case "${2:-}" in
  waiting) echo 'enter go  ^y approve  ^x deny  ^o reply  ^g diff  esc quit' ;;
  working) echo 'enter go  ^x interrupt  ^o reply  ^g diff  esc quit' ;;
  done) echo 'enter go  ^g diff  alt-b PR  ^s seen  esc quit' ;;
  error) echo 'enter go  ^o reply  ^g diff  ^s seen  esc quit' ;;
  '') echo 'esc quit' ;;
  *) echo 'enter go  ^o reply  ^g diff  alt-b PR  esc quit' ;;
  esac
  exit 0
  ;;
tick)
  # The 2-second refresh. While the diff is up it does nothing: rerunning it
  # would throw you back to its top in the middle of reading.
  [[ "${FZF_PREVIEW_LABEL:-}" == *diff* ]] || echo "reload-sync($self list)+refresh-preview"
  exit 0
  ;;
preview)
  # ctrl-g: swap the preview between the screen and the git diff.
  if [[ "${FZF_PREVIEW_LABEL:-}" == *diff* ]]; then
    echo "change-preview-label( screen )+change-preview-window(~4,follow)+change-preview(ksesh agent show {1})"
  else
    echo "change-preview-label( diff )+change-preview-window(~0,nofollow)+change-preview(ksesh agent diff {1} --width \$FZF_PREVIEW_COLUMNS --max-file-lines 200)"
  fi
  exit 0
  ;;
reply)
  printf '\033[1mReply to %s\033[0m (enter sends, empty cancels)\n' "$(ksesh agent list --ids --no-color | awk -F'\t' -v id="$2" '$1 == id { sub(/^ +/, "", $3); print $3 }')"
  read -e -r -p '› ' text || exit 0
  [ -z "$text" ] || ksesh agent send "$2" "$text"
  exit 0
  ;;
pr)
  dir="$(ksesh agent path "$2")" || exit 0
  cd "$dir" && gh pr view --web >/dev/null 2>&1 || true
  exit 0
  ;;
close)
  read -r -n 1 -p "Close the agent's window? [y/N] " answer || exit 0
  [[ "$answer" == [yY] ]] && kitten @ close-window --match "id:$2"
  exit 0
  ;;
esac

# An overlay only covers its own window, so in a tab split into several windows
# the picker would be squeezed into one of them. Zoom the tab to the stack
# layout while it is up, unless it is zoomed already, and restore it after.
zoomed=
if ! kitten @ ls --self | grep -q '"layout": "stack"'; then
  kitten @ action --self toggle_layout stack && zoomed=1
fi

state="$(mktemp -d "${TMPDIR:-/tmp}/ksesh-agents.XXXXXX")"
sock="$state/fzf.sock"

refresher=
cleanup() {
  [ -z "$refresher" ] || kill "$refresher" 2>/dev/null || true
  [ -z "$zoomed" ] || kitten @ action --self toggle_layout stack || true
  rm -rf "$state"
}
trap cleanup EXIT

# Keep the list and the screen preview live: statuses change while you look.
# --id-nth keeps the cursor on the same agent across reloads.
(
  while sleep 2; do
    [ -S "$sock" ] || continue
    curl -s --unix-socket "$sock" -X POST http://localhost -d "transform($self tick)" >/dev/null || exit 0
  done
) &
refresher=$!

"$self" list | fzf \
  --listen="$sock" --id-nth 1 \
  --ansi --no-sort --layout reverse --delimiter '\t' --with-nth 3.. --tabstop 1 \
  --nth 1 --border rounded --border-label ' agents ' --info inline-right \
  --prompt '› ' --ghost 'filter by status, session or tab' \
  --footer 'esc quit' \
  --bind "focus:transform-footer($self footer {2})" \
  --bind "result:transform-footer($self footer {2})" \
  --bind 'tab:down,btab:up' \
  --bind 'enter:become(ksesh agent focus {1})' \
  --bind "ctrl-y:execute-silent(ksesh agent send {1} --key enter --if-status waiting)+reload-sync($self list)" \
  --bind "ctrl-x:execute-silent(ksesh agent send {1} --key escape)+reload-sync($self list)" \
  --bind "ctrl-o:execute($self reply {1})+reload-sync($self list)" \
  --bind "ctrl-s:execute-silent(ksesh agent set idle --window {1})+reload-sync($self list)" \
  --bind "ctrl-g:transform($self preview)" \
  --bind 'alt-d:execute(ksesh agent diff {1} --width $FZF_COLUMNS | less -R)' \
  --bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
  --bind "alt-b:execute-silent($self pr {1})" \
  --bind "alt-w:execute($self close {1})+reload-sync($self list)" \
  --bind 'ctrl-/:toggle-preview' \
  --preview-window 'right,60%,~4,follow' \
  --preview-label ' screen ' \
  --preview 'ksesh agent show {1}' || true
